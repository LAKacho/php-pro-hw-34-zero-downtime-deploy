APP_NAME=pspa-target
APP_REPO=https://github.com/example/pspa-target.git
GIT_REF=main
DEPLOY_ROOT=/srv/pspa-target
RELEASES_DIR=/srv/pspa-target/releases
SHARED_DIR=/srv/pspa-target/shared
CURRENT_LINK=/srv/pspa-target/current
CONFIG_FILE=/srv/pspa-target/config/.env.production
APP_PORT=8000

APP_ENV=prod
APP_SECRET=change-me
DATABASE_URL="postgresql://app:app_password@127.0.0.1:5432/app?serverVersion=11&charset=utf8"
MAILER_DSN="smtp://user:pass@smtp.example.com:587"
